{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Covenant: wallet-free site that reads, draws and replays TapeOut circuits on X Layer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "budget": "node scripts/check-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:offline": "SKIP_LIVE=1 vitest run",
    "verify:live": "node scripts/verify-live.ts",
    "verify:kernel": "node scripts/verify-kernel.ts",
    "test:fork": "COVENANT_FORK=web/.fork/deployment.json vitest run test/fork.test.ts",
    "dev:fork": "COVENANT_FORK=web/.fork/deployment.json vite",
    "fork:fixture": "bash scripts/fork-fixture.sh"
  },
  "dependencies": {
    "@covenant/chain": "workspace:*",
    "@covenant/dieshot": "workspace:*",
    "@covenant/tap20": "workspace:*",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
