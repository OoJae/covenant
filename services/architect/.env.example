# Covenant Architect. Copy to .env for local runs (never commit .env), or set these as Railway variables.
# Values here are intentionally empty. See README.md for what each one does.

# --- the paid route: POST /v1/architect/chip ----------------------------------------------------------
# All of the following must be set for the paid route to sell. Until then it answers 503 and says which
# ones are missing; the free route and /healthz work regardless.

# OKX developer API credentials, used to sign the calls to OKX's x402 facilitator. SECRETS.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# The X Layer address that receives the USDT0. Checksummed or all-lowercase.
PAY_TO=

# The public https origin of this deployment, without a path. The 402 challenge names the endpoint URL
# built from it. On Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=

# The command that runs the chip toolchain (see the CLI contract in src/toolchain.ts). While it is unset
# the service is in STUB mode: the free route returns a fixed demo payload and the paid route stays closed.
# In the Docker image: python -m tapc architect   (once the chips toolchain provides that entry point)
TAPC_CMD=

# --- optional (defaults shown in comments) -------------------------------------------------------------
# Price per call in USD, paid in USDT0. Default 0.50. At most 6 decimals. Must match the OKX.AI listing fee.
PRICE_USD=
# live | mock. Default live. mock never contacts OKX and accepts only mock payments: for local tests only.
X402_MODE=
# Wait for on-chain confirmation before the result is released. Default 1.
X402_SYNC_SETTLE=
# Validity of a payment authorisation, in seconds. Default 300.
X402_MAX_TIMEOUT_SECONDS=
# After the facilitator answers "timeout": how long its status is polled before the chain is asked. Default 5000.
X402_SETTLE_POLL_MS=
# Override the facilitator host (https://host, no path). Default: the SDK's (https://web3.okx.com).
OKX_BASE_URL=
# JSON-RPC endpoints used only to confirm a settlement on chain after a facilitator timeout.
# Default https://rpc.xlayer.tech,https://xlayerrpc.okx.com
RPC_URLS=

# Listening port and address. Railway sets PORT. Defaults 8787 (8080 in the Docker image) and 0.0.0.0.
PORT=
HOST=
# Free-route requests per client address per minute. Default 10.
RATE_LIMIT_PER_MIN=
# Paid-route requests per client address per minute. Default 120.
PAID_RATE_LIMIT_PER_MIN=
# Largest accepted request body, in bytes. Default 16384.
BODY_LIMIT_BYTES=
# Toolchain runs allowed at the same time; further requests get 503 "busy". Default 2.
MAX_CONCURRENT_COMPILES=
# Successful compiles kept in memory, keyed by (preset, params). 0 turns the cache off. Default 64.
COMPILE_CACHE_ENTRIES=
# 1 = take the client address from the proxy's X-Real-IP header. Default: 1 on Railway, 0 elsewhere.
TRUST_PROXY=
# Preset compiled when the request names none. Default flow-governor.
DEFAULT_PRESET=
# Allowed browser origins, comma-separated, or *. Default *.
CORS_ORIGINS=
# Toolchain time limit in ms (at most 280000). Default 120000.
TAPC_TIMEOUT_MS=
# Working directory for the toolchain command. Default: the service's.
TAPC_CWD=
# Where yowasp-yosys caches its compiled WebAssembly. Set in the Docker image to /var/cache/yowasp.
YOWASP_CACHE_DIR=
# Unit price of a transistor in wei, used only by the stub's cost figure. Default 20000000000000 (0.00002 OKB).
TRANSISTOR_PRICE_WEI=
# debug | info | warn | error. Default info.
LOG_LEVEL=
