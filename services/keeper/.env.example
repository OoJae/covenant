# Covenant keeper. Copy to .env for local runs (never commit .env), or set these as Railway variables /
# GitHub Actions secrets. Values here are intentionally empty. See README.md for what each one does.

# --- required -------------------------------------------------------------------------------------
# Comma-separated kernel addresses to keep settled.
KERNELS=

# Private key of the declared keeper wallet (64 hex characters, with or without 0x).
# SECRET. Not needed when DRY_RUN=1. The process deletes it from its environment after reading it
# and never logs it.
KEEPER_PRIVATE_KEY=

# --- recommended ----------------------------------------------------------------------------------
# KeeperTank address. When set, the keeper calls KeeperTank.settleAndRefund(kernel) so its gas is
# refunded; when empty it calls kernel.settle() directly and pays the gas itself.
TANK=

# The declared keeper wallet address. When set, the process refuses to start if KEEPER_PRIVATE_KEY
# belongs to a different address. In dry-run mode without a key, simulations are made from it.
KEEPER_ADDRESS=

# --- optional (defaults shown in comments) ---------------------------------------------------------
# Comma-separated JSON-RPC endpoints, tried in order. Default: https://rpc.xlayer.tech,https://xlayerrpc.okx.com
RPC_URLS=
# Default 196 (X Layer mainnet). Every reachable RPC must report this chain id.
CHAIN_ID=
# Upper bound on maxFeePerGas, in gwei. Default 0.1 (five times the 0.02 gwei base fee of October 2026).
MAX_FEE_GWEI=
# Tip, in gwei. Default 0.001. Keep it at or below 0.01: the tank refunds at most basefee + 0.01 gwei per gas.
PRIORITY_FEE_GWEI=
# Never sign a gas limit above this. Default 30000000.
MAX_GAS_LIMIT=
# Seconds between passes in the long-running mode. Default 30.
POLL_INTERVAL_SECONDS=
# Settle only when epochNow - lastEpoch >= this. Default 1. Use 2 for a backup keeper. Range 1..14.
MIN_EPOCH_LAG=
# 1 = simulate and print, never sign or send. Same as --dry-run. Default 0.
DRY_RUN=
# 1 = one pass, then exit. Same as --once. Default 0.
ONCE=
# With TANK set: if the tank path reverts but a direct settle() would succeed, send the direct call. Default 1.
DIRECT_FALLBACK=
# How long one pass waits for a receipt. Default 60.
RECEIPT_TIMEOUT_SECONDS=
# An unmined transaction older than this is replaced at the same nonce by the next due settle. Default 180.
STUCK_TX_SECONDS=
# Per-request RPC timeout. Default 20.
RPC_TIMEOUT_SECONDS=
# Warn when the wallet holds less than this many OKB. Default 0.02.
MIN_BALANCE_OKB=
# Seconds between heartbeat lines. Default 600.
HEARTBEAT_SECONDS=
# File that remembers which epoch was already sent for each kernel, so a restart does not send it twice.
# Default: covenant-keeper-state.json in the system temp directory. "none" keeps it in memory only.
STATE_FILE=
# debug | info | warn | error. Default info.
LOG_LEVEL=
# The tank's refund event, as a human-readable signature. Set it only if the deployed KeeperTank
# declares the event differently from contracts/issuance/src/KeeperTank.sol, which is the default:
#   event Refunded(uint256 indexed chipId, address indexed kernel, address indexed caller, uint256 gasUsed, uint256 paid)
TANK_REFUNDED_EVENT=
